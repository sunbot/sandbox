{
  "expo": {
    "name": "NutriPlan",
    "slug": "nutriplan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nutriplan.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nutriplan.app",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "NutriPlan",
      "shortName": "NutriPlan",
      "themeColor": "#121514",
      "backgroundColor": "#121514"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan food barcodes",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Speak what you ate",
          "speechRecognitionPermission": "Turn your voice into food entries"
        }
      ]
    ],
    "scheme": "nutriplan",
    "experiments": {
      "typedRoutes": true
    }
  }
}